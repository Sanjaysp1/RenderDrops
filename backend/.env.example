# Host to listen on for the backend server.
# By default, listen only on localhost (127.0.0.1) for local development.
API_BACKEND_HOST="127.0.0.1"

# Port to listen on for the backend server.
API_BACKEND_PORT=5000

# Max request payload size accepted by the backend server.
API_PAYLOAD_MAX_SIZE="7mb"

# Google Cloud Project Configuration
# Region/Location associated with your Vertex AI resources
GOOGLE_CLOUD_LOCATION="us-central1"

# Your Google Cloud Project ID
GOOGLE_CLOUD_PROJECT="your-google-cloud-project-id"

# Random secret proxy header value to authorize requests from the frontend app shim.
# This must match the header value hardcoded in the frontend proxy interceptor.
PROXY_HEADER="your-random-proxy-header-value"
